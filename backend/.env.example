# ===== Server =====
SERVER_ADDR=:8080
# Frontend URL, used as the redirect target after a successful login
FRONTEND_URL=https://webkalcer.com
# Origins allowed to call the API (comma separated)
CORS_ORIGINS=https://webkalcer.com,https://www.webkalcer.com

# ===== Database =====
DATABASE_PATH=./data/webkalcer.db

# ===== Security =====
# REQUIRED in production. Key used to encrypt GitHub tokens and hash sessions.
# Generate with: openssl rand -hex 32
# Note: changing this value invalidates every existing session.
SESSION_SECRET=

# ===== GitHub OAuth =====
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=https://api.webkalcer.com/auth/github/callback

# Google OAuth (opsional, untuk login Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://api.webkalcer.com/auth/google/callback

# ===== Cloudflare (automatic DNS) =====
# API token with Zone:DNS:Edit permission for the webkalcer.com zone
CLOUDFLARE_API_KEY=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_DOMAIN=webkalcer.com
# Target of the subdomain record: VPS IP (created as A) or hostname (CNAME)
CLOUDFLARE_TARGET=
# true = traffic goes through the Cloudflare proxy (edge SSL handled automatically)
CLOUDFLARE_PROXY=true

# ===== Transactional email (Resend) =====
# The public order form sends every submission to EMAIL_TO.
# Create an API key at https://resend.com/api-keys (Sending access).
# EMAIL_FROM must use a domain verified in Resend (e.g. no-reply@webkalcer.com).
RESEND_API_KEY=
EMAIL_TO=
EMAIL_TO_NAME=Tim WebKalcer
EMAIL_FROM=no-reply@webkalcer.com
EMAIL_FROM_NAME=WebKalcer

# ===== Build pipeline =====
# Temporary working folder for clone + build
CACHE_DIR=/tmp/webkalcer/cache
# Folder where build output is published and served from
SITES_DIR=/var/lib/webkalcer/sites
# Timeout for a single build (seconds)
BUILD_TIMEOUT_SECONDS=600
# Batas heap Node saat build (MB). Build yang kehabisan memori gagal dengan
# rapi alih-alih memicu OOM killer yang bisa membunuh backend.
BUILD_NODE_HEAP_MB=1024
#
# Catatan pipeline build:
# - Hasil build dipublikasikan lewat symlink atomik:
#   <SITES_DIR>/<subdomain> -> <SITES_DIR>/.releases/<subdomain>/release-*
# - Next.js tanpa `output: "standalone"` dijalankan sebagai `next start`;
#   dependency produksi di-install ulang di folder rilis (bukan disalin).
# - Next.js standalone otomatis mendapat salinan `.next/static` dan `public/`.
# - Env var project di-inject saat build DAN saat runtime proses SSR.
